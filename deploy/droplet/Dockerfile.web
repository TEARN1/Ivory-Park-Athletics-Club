# The app (static files) served by Caddy, which also gets the HTTPS certificate and passes
# server paths (live room, joining, events, club page) to the Node server container.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_SERVER_URL=same-origin
RUN npm run build

FROM caddy:2.8-alpine
COPY deploy/droplet/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
